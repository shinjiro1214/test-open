addpath '/Users/rsomeya/Documents/lab/matlab/common';
run define_path.m

date = 230830;%230523;
shot = 22;%8;
ch = [1 3 4];% 7 8];
calib(ch) = [116.6647*12,225.71*3,-174.19*3/30*35.7];%,63.9568,223.2319];
ch = [3 4];% 7 8];
calib(ch) = [225.71*3,-174.19*3/30*35.7];%,63.9568,223.2319];
