                                                    (multi_PCBdata2D(i_data).Bz_std(idx_r_min+1:idx_r_max,idx_scan,idx_PCB_t) + multi_PCBdata2D(i_data).Bz_std(idx_r_min:idx_r_max-1,idx_scan,idx_PCB_t))./(x(2)-x(1))./(Brlist(i_data)*1e-3));
