%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%ショット番号、撮影パラメータなどを実験ログから自動取得して
%ドップラープローブによるイオン温度の時間発展をプロット
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
clear all
addpath '/Users/rsomeya/Documents/lab/matlab/common';
run define_path.m

%------【input】-------
% % SEP合体、X点R=0.26m、ExBアウトフロー大。IDSP->230830,230831(delay=468, 472, 476us)psi小
% IDSP.date = [230830;230831];%【input】IDSP実験日
% IDSP.shotlist1 = [9 12 15 18 19 21 27 30 31 33 35 36 38 40 46 48 52 53];%【input】IDSPshot番号リスト(Day1)
% IDSP.shotlist2 = [4 5 7 8 13 15 18 20 22 23 26 30];%【input】IDSPshot番号リスト(Day2)
% IDSP.n_CH = 28;%【input】IDSPファイバーCH数(28)
% IDSP.n_r = 7;%【input】IDSPr方向データ数(7)
% IDSP.n_z = 1;%【input】IDSPz方向データ数(1)
% IDSP.int_r = 2.5;%【input】IDSPr方向計測点間隔[cm](2.5)
% single_range = [1:4 6 7];%【input】プロットCH([1:4 7])
% wav_range = [1:12 16:21];%【input】プロットr([1:21],[1:12 19:21])

% SEP合体、X点R=0.26m、ExBアウトフロー大。IDSP->230830,230831(delay=468, 472, 476us)psi大
IDSP.date = [230830;230831];%【input】IDSP実験日
IDSP.shotlist1 = [13 14 16 17 20 22 23 25 26 32 37 41 42:45 47 49 51 54 55 57];%%【input】IDSPshot番号リスト(Day1)
IDSP.shotlist2 = [11 12 14 16 21 28 29 36 37:49];%【input】IDSPshot番号リスト(Day2)
IDSP.n_CH = 28;%【input】IDSPファイバーCH数(28)
IDSP.n_r = 7;%【input】IDSPr方向データ数(7)
IDSP.n_z = 1;%【input】IDSPz方向データ数(1)
IDSP.int_r = 2.5;%【input】IDSPr方向計測点間隔[cm](2.5)
single_range = [1:4 6 7];%【input】プロットCH([1:4 7])
wav_range = [1:12 16:21];%【input】プロットr([1:21],[1:12 19:21])
time_range = [1:6];%【input】プロットt
filename_PCB = [pathname.processeddata,'/a039_2437.mat'];
load(filename_PCB);
filename_ExB = [pathname.mat,'/ExB/','230830_shot11_13-14_16-17_20_22-26_28-29_32_34_37_41-45_47_49_51_54-55_57_59-60-a039_2437_450_1_500.mat'];
load(filename_ExB,'ExBdata2D')

% % 同極性スフェロマック合体 + 外部TF4kV
% IDSP.date = 240827;%【input】静電プローブ計測日
% IDSP.shotlist = [11 12 14:20 22:24 26:45 47:51];%【input】静電プローブ解析shotlist(同一オペレーション)]
% IDSP.n_CH = 20;%【input】IDSPファイバーCH数(28)
% IDSP.n_r = 5;%【input】IDSPr方向データ数(7)
% IDSP.n_z = 1;%【input】IDSPz方向データ数(1)
% IDSP.int_r = 2.5;%【input】IDSPr方向計測点間隔[cm](2.5)
% single_range = [1:5];%【input】プロットCH([1:4 7])
% wav_range = [1:5];%【input】プロットr([1:21],[1:12 19:21])

% % % 同極性スフェロマック合体 + 外部TF5kV
% IDSP.date = 240828;%【input】静電プローブ計測日
% IDSP.shotlist = [30:41 43:46 48:54];%【input】静電プローブ解析shotlist(同一オペレーション)
% IDSP.n_CH = 20;%【input】IDSPファイバーCH数(28)
% IDSP.n_r = 5;%【input】IDSPr方向データ数(7)
% IDSP.n_z = 1;%【input】IDSPz方向データ数(1)
% IDSP.int_r = 2.5;%【input】IDSPr方向計測点間隔[cm](2.5)
% single_range = [1:5];%【input】プロットCH([1:4 7])
% wav_range = [1:5];%【input】プロットr([1:21],[1:12 19:21])

% % 同極性スフェロマック合体 + 外部TF6kV
% IDSP.date = 240828;%【input】静電プローブ計測日
% IDSP.shotlist = [3:12 14:22 25:29];%【input】静電プローブ解析shotlist(同一オペレーション)
% IDSP.n_CH = 20;%【input】IDSPファイバーCH数(28)
% IDSP.n_r = 5;%【input】IDSPr方向データ数(7)
% IDSP.n_z = 1;%【input】IDSPz方向データ数(1)
% IDSP.int_r = 2.5;%【input】IDSPr方向計測点間隔[cm](2.5)
% single_range = [1:5];%【input】プロットCH([1:4 7])
% wav_range = [1:5];%【input】プロットr([1:21],[1:12 19:21])

plot_single = false;%【input】IDSPシングルショットをプロット
plot_WAV = true;%【input】IDSP重み付き平均をプロット
plot_ytype = 'nPvis';%【input】プロットy軸'Ti','dTi','Vz','Vr','|Vr|','dVr/dr','dTi/dt','Kr','VExBr'
plot_linetype = 'contour';%【input】プロット種類'errbar','line','contour'

%------IDSP詳細設定【input】------
plot_fit = false;%【input】ガウスフィッティングを表示(true,false)
save_fit = false;%【input】ガウスフィッティングpngを保存(true,false)
show_offset = false;%【input】分光offsetを表示(true,false)

colorlist = ["#000000","#FF4B00","#F6AA00","#FFF100","#03AF7A","#4DC4FF","#005AFF","#990099"];%プロット色の順番["#FF4B00","#F6AA00","#FFF100","#03AF7A","#4DC4FF","#005AFF","#990099","#000000"]

DOCID='1wG5fBaiQ7-jOzOI-2pkPAeV6SDiHc_LrOdcbWlvhHBw';%スプレッドシートのID
T=getTS6log(DOCID);
node='date';
%--------実験ログ取得(day1)---------
T1=searchlog(T,node,IDSP.date(1));
IDSP.shotlist1(ismember(IDSP.shotlist1,T1.shot)==0) = [];
IDSP.datelist = IDSP.date(1)*ones(numel(IDSP.shotlist1),1);
IDSP.shotlist = IDSP.shotlist1;
n_data=numel(IDSP.shotlist1);%計測shot数
PCBshotlist_a039 =T1.a039(IDSP.shotlist1);
PCBshotlist_a040 = T1.a040(IDSP.shotlist1);
PCBshotlist = [PCBshotlist_a039, PCBshotlist_a040];
PCBtfshotlist_a039 =T1.a039_TF(IDSP.shotlist1);
PCBtfshotlist_a040 =T1.a040_TF(IDSP.shotlist1);
PCBtfshotlist = [PCBtfshotlist_a039, PCBtfshotlist_a040];
PF1list=T1.CB1_kV_(IDSP.shotlist1);
PF2list=T1.CB2_kV_(IDSP.shotlist1);
TFlist=T1.TF_kV_(IDSP.shotlist1);
EFlist=T1.EF_A_(IDSP.shotlist1);
Gaslist=T1.gas(IDSP.shotlist1);
IDSPminZlist=T1.IDSPZ_cm_(IDSP.shotlist1);
IDSPminRlist=T1.IDSPMinR_cm_(IDSP.shotlist1);
IDSPdelaylist=T1.IDSPDelay_us_(IDSP.shotlist1);
IDSPwidthlist=T1.IDSPWidth_us_(IDSP.shotlist1);
IDSPgainlist=T1.IDSPGain(IDSP.shotlist1);
IDSPtimelist=round(IDSPdelaylist+IDSPwidthlist/2);

if numel(IDSP.date) > 1
    %--------実験ログ取得(day2)---------
    T2=searchlog(T,node,IDSP.date(2));
    IDSP.shotlist2(ismember(IDSP.shotlist2,T2.shot)==0) = [];
    IDSP.datelist = [IDSP.datelist;IDSP.date(2)*ones(numel(IDSP.shotlist2),1)];
    IDSP.shotlist = [IDSP.shotlist,IDSP.shotlist2];
    n_data=n_data+numel(IDSP.shotlist2);%計測shot数
    PCBshotlist_a039 = [PCBshotlist_a039;T2.a039(IDSP.shotlist2)];
    PCBshotlist_a040 = [PCBshotlist_a040;T2.a040(IDSP.shotlist2)];
    PCBshotlist = [PCBshotlist_a039, PCBshotlist_a040];
    PCBtfshotlist_a039 =[PCBtfshotlist_a039;T2.a039_TF(IDSP.shotlist2)];
    PCBtfshotlist_a040 =[PCBtfshotlist_a040;T2.a040_TF(IDSP.shotlist2)];
    PCBtfshotlist = [PCBtfshotlist_a039, PCBtfshotlist_a040];
    PF1list=[PF1list;T2.CB1_kV_(IDSP.shotlist2)];
    PF2list=[PF2list;T2.CB2_kV_(IDSP.shotlist2)];
    TFlist=[TFlist;T2.TF_kV_(IDSP.shotlist2)];
    EFlist=[EFlist;T2.EF_A_(IDSP.shotlist2)];
    Gaslist=[Gaslist;T2.gas(IDSP.shotlist2)];
    IDSPminZlist=[IDSPminZlist;T2.IDSPZ_cm_(IDSP.shotlist2)];
    IDSPminRlist=[IDSPminRlist;T2.IDSPMinR_cm_(IDSP.shotlist2)];
    IDSPdelaylist=[IDSPdelaylist;T2.IDSPDelay_us_(IDSP.shotlist2)];
    IDSPwidthlist=[IDSPwidthlist;T2.IDSPWidth_us_(IDSP.shotlist2)];
    IDSPgainlist=[IDSPgainlist;T2.IDSPGain(IDSP.shotlist2)];
    IDSPtimelist=round(IDSPdelaylist+IDSPwidthlist/2);
end

buf_minR = sort(rmmissing(unique(IDSPminRlist)));
for i=1:size(buf_minR,1)
    buf_r = ((buf_minR(i):IDSP.int_r:buf_minR(i)+(IDSP.n_r-1)*IDSP.int_r)*1E-2)';
    if i == 1
        WAV_IDSPdata.r = buf_r;
    else
        WAV_IDSPdata.r = cat(1,WAV_IDSPdata.r,buf_r);%統合後IDSPdata R座標[m]
    end
end

WAV_IDSPdata.time = sort(rmmissing(unique(IDSPtimelist)));%統合後IDSPdata 時間[us]
WAV_IDSPdata.time = WAV_IDSPdata.time(time_range);
WAV_IDSPdata.T_i = zeros(size(WAV_IDSPdata.r,1),size(WAV_IDSPdata.time,1));%T_i重み付き平均
WAV_IDSPdata.dT_i = zeros(size(WAV_IDSPdata.r,1),size(WAV_IDSPdata.time,1));%T_i重み付き平均
WAV_IDSPdata.err_T_i = zeros(size(WAV_IDSPdata.r,1),size(WAV_IDSPdata.time,1));%T_i重み付き平均の誤差分散
WAV_IDSPdata.V_z = zeros(size(WAV_IDSPdata.r,1),size(WAV_IDSPdata.time,1));%V_z重み付き平均
WAV_IDSPdata.err_V_z = zeros(size(WAV_IDSPdata.r,1),size(WAV_IDSPdata.time,1));%V_z重み付き平均の誤差分散
WAV_IDSPdata.V_r = zeros(size(WAV_IDSPdata.r,1),size(WAV_IDSPdata.time,1));%V_r重み付き平均
WAV_IDSPdata.err_V_r = zeros(size(WAV_IDSPdata.r,1),size(WAV_IDSPdata.time,1));%V_r重み付き平均の誤差分散
sum_weight_T_i = zeros(size(WAV_IDSPdata.r,1),size(WAV_IDSPdata.time,1));
sum_weight_V_z = zeros(size(WAV_IDSPdata.r,1),size(WAV_IDSPdata.time,1));
sum_weight_V_r = zeros(size(WAV_IDSPdata.r,1),size(WAV_IDSPdata.time,1));
cnt = zeros(size(WAV_IDSPdata.r,1),size(WAV_IDSPdata.time,1));
legendStrings = "";
hs = char.empty;

switch plot_linetype
    case {'errbar','line'}
        figure('Position', [0 0 600 600],'visible','on');
end
idx_IDSP_z_min = knnsearch(ExBdata2D.zq(1,:)',0.021-0.016);
idx_IDSP_z_max = knnsearch(ExBdata2D.zq(1,:)',0.021+0.016);
VExB_z = zeros(size(ExBdata2D.VExB_z,1),numel(WAV_IDSPdata.time));
VExB_r = zeros(size(ExBdata2D.VExB_r,1),numel(WAV_IDSPdata.time));
VExB_z_2D = zeros(size(ExBdata2D.VExB_r,1),idx_IDSP_z_max-idx_IDSP_z_min+3,numel(WAV_IDSPdata.time));
VExB_r_2D = zeros(size(ExBdata2D.VExB_r,1),idx_IDSP_z_max-idx_IDSP_z_min+3,numel(WAV_IDSPdata.time));
for i_t = 1:numel(WAV_IDSPdata.time)
    plot_time = WAV_IDSPdata.time(i_t);
    for i=1:n_data
        IDSP.date=IDSP.datelist(i);
        IDSP.shot=IDSP.shotlist(i);
        IDSP.line=Gaslist(i);
        IDSP.delay=IDSPdelaylist(i);
        IDSP.width=IDSPwidthlist(i);
        IDSP.gain=IDSPgainlist(i);
        IDSP.time=IDSPtimelist(i);
        IDSP.z = IDSPminZlist(i)*ones(7,1)*1E-2;%IDSP計測点Z座標[m]
        IDSP.r = ((IDSPminRlist(i):IDSP.int_r:IDSPminRlist(i)+(IDSP.n_r-1)*IDSP.int_r)*1E-2)';%IDSP計測点R座標[m]
        if not(isnan(IDSP.delay)) && (IDSP.time == plot_time)
            %IDSP計算
            IDSPdata = cal_ionflow(IDSP,pathname,show_offset,plot_fit,save_fit);
            if plot_single
                if IDSP.time == plot_time
                    switch plot_linetype
                        case {'errbar','line'}
                            switch plot_ytype
                                case 'Ti'
                                    p = errorbar(IDSPdata.r(single_range),IDSPdata.T_i(single_range,1),IDSPdata.err_T_i(single_range,1),'*-');
                                case 'Vz'
                                    p = errorbar(IDSPdata.r(single_range),IDSPdata.V_i(single_range,1),IDSPdata.err_V_i(single_range,1),'*-');
                                case 'Vr'
                                    p = errorbar(IDSPdata.r(single_range),IDSPdata.V_i(single_range,2),IDSPdata.err_V_i(single_range,2),'*-');
                            end
                    end
                    for i_p = 1:size(p,2)
                        p(i_p).Color = colorlist(i_t);
                        hold on
                    end
                end
            end
            %誤差補正
            err_factor = 5;%誤差係数
            IDSPdata.err_V_i = IDSPdata.err_V_i.*err_factor;
            %加重平均計算
            idx_r = find(WAV_IDSPdata.r==IDSPdata.r(1,1));
            IDSPdata.time = round(IDSPdata.delay+IDSPdata.width/2);
            weight_T_i = 1./IDSPdata.err_T_i.^2;%重み1/σ^2
            WAV_IDSPdata.T_i(idx_r:idx_r+IDSP.n_r-1,i_t) = WAV_IDSPdata.T_i(idx_r:idx_r+IDSP.n_r-1,i_t) + IDSPdata.T_i.*weight_T_i;
            sum_weight_T_i(idx_r:idx_r+IDSP.n_r-1,i_t) = sum_weight_T_i(idx_r:idx_r+IDSP.n_r-1,i_t) + weight_T_i;
            weight_V_z = 1./IDSPdata.err_V_i(:,1).^2;%重み1/σ^2
            WAV_IDSPdata.V_z(idx_r:idx_r+IDSP.n_r-1,i_t) = WAV_IDSPdata.V_z(idx_r:idx_r+IDSP.n_r-1,i_t) + IDSPdata.V_i(:,1).*weight_V_z;
            sum_weight_V_z(idx_r:idx_r+IDSP.n_r-1,i_t) = sum_weight_V_z(idx_r:idx_r+IDSP.n_r-1,i_t) + weight_V_z;
            weight_V_r = 1./IDSPdata.err_V_i(:,2).^2;%重み1/σ^2
            WAV_IDSPdata.V_r(idx_r:idx_r+IDSP.n_r-1,i_t) = WAV_IDSPdata.V_r(idx_r:idx_r+IDSP.n_r-1,i_t) + IDSPdata.V_i(:,2).*weight_V_r;
            sum_weight_V_r(idx_r:idx_r+IDSP.n_r-1,i_t) = sum_weight_V_r(idx_r:idx_r+IDSP.n_r-1,i_t) + weight_V_r;
            cnt(idx_r:idx_r+IDSP.n_r-1,i_t) = cnt(idx_r:idx_r+IDSP.n_r-1,i_t) +1;
        end
    end
    WAV_IDSPdata.T_i(:,i_t) = WAV_IDSPdata.T_i(:,i_t)./sum_weight_T_i(:,i_t);
    % if i_t == 1
    %     buf_T0 = reshape(WAV_IDSPdata.T_i(:,1),IDSP.n_r,[]);
    %     for i_r = 1:IDSP.n_r
    %         buf_T0(i_r,isnan(buf_T0(i_r,:))) = nanmean(buf_T0(i_r,:));
    %     end
    %     WAV_IDSPdata.T_i(:,1) = reshape(buf_T0,[],1);
    % end
    WAV_IDSPdata.dT_i(:,i_t) = WAV_IDSPdata.T_i(:,i_t) - WAV_IDSPdata.T_i(:,1);
    WAV_IDSPdata.err_T_i(:,i_t) = 1./sqrt(sum_weight_T_i(:,i_t));
    WAV_IDSPdata.err_dT_i(:,i_t) = WAV_IDSPdata.err_T_i(:,i_t) + WAV_IDSPdata.err_T_i(:,1);
    WAV_IDSPdata.V_z(:,i_t) = WAV_IDSPdata.V_z(:,i_t)./sum_weight_V_z(:,i_t);
    WAV_IDSPdata.err_V_z(:,i_t) = 1./sqrt(sum_weight_V_z(:,i_t));
    WAV_IDSPdata.V_r(:,i_t) = WAV_IDSPdata.V_r(:,i_t)./sum_weight_V_r(:,i_t);
    WAV_IDSPdata.err_V_r(:,i_t) = 1./sqrt(sum_weight_V_r(:,i_t));
    idx_ExB_time = knnsearch(ExBdata2D.trange',plot_time);
    VExB_z_2D(:,:,i_t) = mean(ExBdata2D.VExB_z(:,idx_IDSP_z_min-1:idx_IDSP_z_max+1,idx_ExB_time-2:idx_ExB_time+2),3);
    VExB_r_2D(:,:,i_t) = mean(ExBdata2D.VExB_r(:,idx_IDSP_z_min-1:idx_IDSP_z_max+1,idx_ExB_time-2:idx_ExB_time+2),3);
    VExB_z_mean = mean(ExBdata2D.VExB_z(:,idx_IDSP_z_min:idx_IDSP_z_max,idx_ExB_time-2:idx_ExB_time+2),3);
    VExB_z(:,i_t) = mean(VExB_z_mean,2);
    VExB_r_mean = mean(ExBdata2D.VExB_r(:,idx_IDSP_z_min:idx_IDSP_z_max,idx_ExB_time-2:idx_ExB_time+2),3);
    VExB_r(:,i_t) = mean(VExB_r_mean,2);
    % figure
    % factor = 3E-3;
    % quiver(ExBdata2D.zq(:,idx_IDSP_z_min:idx_IDSP_z_max),ExBdata2D.rq(:,idx_IDSP_z_min:idx_IDSP_z_max),VExB_z_mean*factor,VExB_r_mean*factor,'off')
    % Fx = mean(ExBdata2D.VExB_r(:,:,idx_ExB_time-2:idx_ExB_time+2),3);
    % Fy = mean(ExBdata2D.VExB_z(:,:,idx_ExB_time-2:idx_ExB_time+2),3);
    % VExB_div(:,:,i_t) = divergence(ExBdata2D.rq(:,idx_IDSP_z_min:idx_IDSP_z_max),ExBdata2D.zq(:,idx_IDSP_z_min:idx_IDSP_z_max),VExB_r_mean,VExB_z_mean);
    switch plot_linetype
        case {'errbar','line'}
            if plot_WAV
                switch plot_ytype
                    case 'dTi'
                        if i_t == 1
                            h = yline(0,'k','LineWidth',3);
                            if isempty(hs)
                                hs = h;
                            else
                                hs = [hs h];
                            end
                            if legendStrings == ""
                                legendStrings = [num2str(plot_time) 'us'];
                            else
                                legendStrings = [legendStrings, string([num2str(plot_time),'us'])];
                            end
                        else
                            buf = cat(2,WAV_IDSPdata.r,WAV_IDSPdata.dT_i(:,i_t));
                            buf = sortrows(cat(2,buf,WAV_IDSPdata.err_dT_i(:,i_t)));
                            buf = buf(wav_range,:);
                            id_NAN = isnan(buf(:,2));
                            buf(id_NAN, :) = [];
                            buf(:,2) = movmean(buf(:,2),3,1);
                            buf(:,3) = movmean(buf(:,3),3,1);
                            err_WAV_y = buf(:,3);
                            err_WAV_xpos = 0.01;
                            err_WAV_xneg = 0.015;
                            switch plot_linetype
                                case 'errbar'
                                    p_WAV = errorbar(buf(:,1),buf(:,2),err_WAV_y,err_WAV_y,err_WAV_xneg,err_WAV_xpos,'o','MarkerSize',4,'LineWidth',3);
                                    for i_p = 1:size(p_WAV,2)
                                        p_WAV(i_p).Color = colorlist(i_t);
                                        hold on
                                    end
                                case 'line'
                                    p_line = plot(buf(:,1),buf(:,2),'o-','LineWidth',3);
                                    p_line.Color = colorlist(i_t);
                                    hold on
                            end
                            h = plot(nan,nan,'o-','MarkerSize',4,'LineWidth',3);
                            h.Color = colorlist(i_t);
                            hold on
                            if isempty(hs)
                                hs = h;
                            else
                                hs = [hs h];
                            end
                            if legendStrings == ""
                                legendStrings = [num2str(plot_time) 'us'];
                            else
                                legendStrings = [legendStrings, string([num2str(plot_time),'us'])];
                            end
                        end
                    case 'Ti'
                        buf = cat(2,WAV_IDSPdata.r,WAV_IDSPdata.T_i(:,i_t));
                        buf = sortrows(cat(2,buf,WAV_IDSPdata.err_T_i(:,i_t)));
                        buf = buf(wav_range,:);
                        id_NAN = isnan(buf(:,2));
                        buf(id_NAN, :) = [];
                        % buf(:,2) = movmean(buf(:,2),3,1);
                        % buf(:,3) = movmean(buf(:,3),3,1);
                        err_WAV_y = buf(:,3);
                        err_WAV_xpos = 0.01;
                        err_WAV_xneg = 0.015;
                        switch plot_linetype
                            case 'errbar'
                                p_WAV = errorbar(buf(:,1),buf(:,2),err_WAV_y,err_WAV_y,err_WAV_xneg,err_WAV_xpos,'o','MarkerSize',4,'LineWidth',3);
                                for i_p = 1:size(p_WAV,2)
                                    p_WAV(i_p).Color = colorlist(i_t);
                                    hold on
                                end
                            case 'line'
                                p_line = plot(buf(:,1),buf(:,2),'o-','LineWidth',3);
                                p_line.Color = colorlist(i_t);
                                hold on
                        end
                        drawnow
                        h = plot(nan,nan,'o-','MarkerSize',4,'LineWidth',3);
                        h.Color = colorlist(i_t);
                        hold on
                        if isempty(hs)
                            hs = h;
                        else
                            hs = [hs h];
                        end
                        if legendStrings == ""
                            legendStrings = [num2str(plot_time) 'us'];
                        else
                            legendStrings = [legendStrings, string([num2str(plot_time),'us'])];
                        end
                    case 'Vz'
                        buf = cat(2,WAV_IDSPdata.r,WAV_IDSPdata.V_z(:,i_t));
                        buf = sortrows(cat(2,buf,WAV_IDSPdata.err_V_z(:,i_t)));
                        buf = buf(wav_range,:);
                        id_NAN = isnan(buf(:,2));
                        buf(id_NAN, :) = [];
                        buf(:,2) = movmean(buf(:,2),round(2*size(buf,1)/numel(single_range)),1);
                        buf(:,3) = movmean(buf(:,3),round(2*size(buf,1)/numel(single_range)),1);
                        err_WAV_y = buf(:,3);
                        err_WAV_xpos = 0.01;
                        err_WAV_xneg = 0.015;
                        switch plot_linetype
                            case 'errbar'
                                p_WAV = errorbar(buf(:,1),buf(:,2),err_WAV_y,err_WAV_y,err_WAV_xneg,err_WAV_xpos,'o','MarkerSize',4,'LineWidth',3);
                                for i_p = 1:size(p_WAV,2)
                                    p_WAV(i_p).Color = colorlist(i_t);
                                    hold on
                                end
                            case 'line'
                                p_line = plot(buf(:,1),buf(:,2),'o-','LineWidth',3);
                                p_line.Color = colorlist(i_t);
                                hold on
                        end
                        h = plot(nan,nan,'o-','MarkerSize',4,'LineWidth',3);
                        h.Color = colorlist(i_t);
                        hold on
                        if isempty(hs)
                            hs = h;
                        else
                            hs = [hs h];
                        end
                        if legendStrings == ""
                            legendStrings = [num2str(plot_time) 'us'];
                        else
                            legendStrings = [legendStrings, string([num2str(plot_time),'us'])];
                        end
                    case 'Vr'
                        buf = cat(2,WAV_IDSPdata.r,WAV_IDSPdata.V_r(:,i_t));
                        buf = sortrows(cat(2,buf,WAV_IDSPdata.err_V_r(:,i_t)));
                        buf = buf(wav_range,:);
                        id_NAN = isnan(buf(:,2));
                        buf(id_NAN, :) = [];
                        buf(:,2) = movmean(buf(:,2),round(2*size(buf,1)/numel(single_range)),1);
                        buf(:,3) = movmean(buf(:,3),round(2*size(buf,1)/numel(single_range)),1);
                        err_WAV_y = buf(:,3);
                        err_WAV_xpos = 0.01;
                        err_WAV_xneg = 0.015;
                        switch plot_linetype
                            case 'errbar'
                                p_WAV = errorbar(buf(:,1),buf(:,2),err_WAV_y,err_WAV_y,err_WAV_xneg,err_WAV_xpos,'o','MarkerSize',4,'LineWidth',3);
                                for i_p = 1:size(p_WAV,2)
                                    p_WAV(i_p).Color = colorlist(i_t);
                                    hold on
                                end
                            case 'line'
                                p_line = plot(buf(:,1),buf(:,2),'o-','LineWidth',3);
                                p_line.Color = colorlist(i_t);
                                hold on
                        end
                        h = plot(nan,nan,'o-','MarkerSize',4,'LineWidth',3);
                        h.Color = colorlist(i_t);
                        hold on
                        if isempty(hs)
                            hs = h;
                        else
                            hs = [hs h];
                        end
                        if legendStrings == ""
                            legendStrings = [num2str(plot_time) 'us'];
                        else
                            legendStrings = [legendStrings, string([num2str(plot_time),'us'])];
                        end
                end
            end
            hold on
    end
end

switch plot_linetype
    case 'contour'
        % figure('Position', [0 0 1200 300],'visible','on');
        buf_dTi = cat(2,WAV_IDSPdata.r,WAV_IDSPdata.dT_i);
        buf_dTi = sortrows(buf_dTi);
        buf_dTi = buf_dTi(wav_range,:);
        id_NAN = isnan(buf_dTi(:,2));
        buf_dTi(id_NAN, :) = [];
        buf_dTi(:,2:end) = movmean(buf_dTi(:,2:end),3,1);
        buf_dTi(:,2:end) = movmean(buf_dTi(:,2:end),3,2);
        buf_dTi(:,2:end) = buf_dTi(:,2:end) - repmat(buf_dTi(:,2),1,size(buf_dTi(:,2:end),2));
        buf_Vz = cat(2,WAV_IDSPdata.r,WAV_IDSPdata.V_z);
        buf_Vz = sortrows(buf_Vz);
        buf_Vz = buf_Vz(wav_range,:);
        buf_Vz = fillmissing(buf_Vz, 'spline', 1);
        buf_Vr = cat(2,WAV_IDSPdata.r,WAV_IDSPdata.V_r);
        buf_Vr = sortrows(buf_Vr);
        WAV_IDSPdata.r = buf_Vr(:,1);
        WAV_IDSPdata.V_r = buf_Vr(:,2:end);
        buf_Vr = buf_Vr(wav_range,:);
        buf_Vr = fillmissing(buf_Vr, 'spline', 1);
        % n_i = 10^(20);%[/m^3]
        m_i = 40*1.67E-27;%[kg]
        % rho_i = n_i*m_i;%[kg/m^3]
        buf_Vr(:,2:end) = movmean(buf_Vr(:,2:end),3,1);
        buf_Vr(:,2:end) = movmean(buf_Vr(:,2:end),3,2);
        buf_Vz(:,2:end) = movmean(buf_Vz(:,2:end),3,1);
        buf_Vz(:,2:end) = movmean(buf_Vz(:,2:end),3,2);
        Kr = 1/2*m_i*(buf_Vr(:,2:end)*10^3).^2./1.6E-19;%[eV]
        Kz = 1/2*m_i*(buf_Vz(:,2:end)*10^3).^2./1.6E-19;%[eV]
        Krz = Kr + Kz;%[eV]
        Krz_for_Ti = Krz;%[eV]
        Krz_for_Ti(id_NAN, :) = [];
        KExB_r = zeros(size(buf_dTi(:,2:end)));
        KExB_z = zeros(size(buf_dTi(:,2:end)));
        n_i = 5E19;%[m^-3]
        % omega_ci = 2*pi*1.55E7*0.5/40;
        T0 = min(buf_dTi(:,2:end),[],'all');
        gnu_ii = 4E-12*n_i*10./(buf_dTi(:,2:end)-T0+10).^(3/2)*sqrt(1/4E4);
        tau_ii = 1./gnu_ii;%[s]
        % eta_R = 0.3*n_i*(buf_dTi(:,2:end)-T0+10)./tau_ii/(omega_ci)^2;
        eta_D = 0.3*n_i*tau_ii.*(buf_dTi(:,2:end)-T0+10);
        % eta_ratio = eta_D./eta_R;
        e = 1.60218e-19;
        nP_vis = zeros(size(buf_dTi(:,2:end)));%粘性加熱パワー密度[W/m^3]
        P_vis = zeros(size(buf_dTi(:,2:end)));%粘性加熱パワー[W]
        W_vis = zeros(size(buf_dTi(:,2:end)));%粘性加熱エネルギー[J]
        for i_r = 1:size(buf_dTi(:,1))
            idx_ExB_r = knnsearch(ExBdata2D.rq(:,1),buf_dTi(i_r,1));
            KExB_r(i_r,:) = 1/2*m_i*(VExB_r(idx_ExB_r,:).*10^3).^2./1.6E-19;
            KExB_z(i_r,:) = 1/2*m_i*(VExB_z(idx_ExB_r,:).*10^3).^2./1.6E-19;
            dvzdz = (squeeze(VExB_z_2D(i_r,round(size(VExB_z_2D,2)/2),:))-squeeze(VExB_z_2D(i_r,round(size(VExB_z_2D,2)/2)-1,:))).*10^3./(ExBdata2D.zq(1,2)-ExBdata2D.zq(1,1));
            dvrdr = (VExB_r(idx_ExB_r+1,:)-VExB_r(idx_ExB_r,:)).*10^3./(ExBdata2D.rq(idx_ExB_r+1,1)-ExBdata2D.rq(idx_ExB_r,1));
            div_v=dvzdz'+dvrdr+VExB_r(idx_ExB_r,:)*10^3/buf_dTi(i_r,1);
            nP_vis(i_r,:) = eta_D(i_r,:).*(div_v).^2*e;
            P_vis(i_r,:) = nP_vis(i_r,:).*2*pi*buf_dTi(i_r,1)*0.032*(buf_dTi(2,1)-buf_dTi(1,1));
            for i_t = 1:size(buf_dTi(:,1))
            W_vis(i_r,:) = sum(P_vis(i_r,:));
        end
        KExB = KExB_r + KExB_z;
        switch plot_ytype
            case 'nPvis'
                figure('Position', [0 0 1200 400],'visible','on');
                contourf(WAV_IDSPdata.time,buf_dTi(:,1),nP_vis,1000,'LineStyle','none')
                c = colorbar;
                colormap("jet")
                % clim([-12 0])
                c.Label.String = 'nP_{viscosity} [W/m^3]';
            case 'Pvis'
                figure('Position', [0 0 1200 400],'visible','on');
                contourf(WAV_IDSPdata.time,buf_dTi(:,1),P_vis,1000,'LineStyle','none')
                c = colorbar;
                colormap("jet")
                % clim([-12 0])
                c.Label.String = 'P_{viscosity} [W]';
            case 'VExBr'
                contourf(WAV_IDSPdata.time,ExBdata2D.rq(:,1),VExB_r,[-15:0.1:0],'LineStyle','none')
                c = colorbar;
                colormap("jet")
                clim([-12 0])
                c.Label.String = 'V_{ExB,r} [km/s]';
            case 'VExBz'
                contourf(WAV_IDSPdata.time,ExBdata2D.rq(:,1),VExB_z,100,'LineStyle','none')
                c = colorbar;
                colormap("jet")
                % clim([-12 0])
                c.Label.String = 'V_{ExB,z} [km/s]';
            case 'KExBr'
                contourf(WAV_IDSPdata.time,buf_dTi(:,1),KExB_r,[-10:0.1:50],'LineStyle','none')
                c = colorbar;
                colormap("jet")
                clim([0 30])
                c.Label.String = 'K_{ExB,r} [eV]';
            case 'KExB'
                contourf(WAV_IDSPdata.time,buf_dTi(:,1),KExB,[-10:0.1:50],'LineStyle','none')
                c = colorbar;
                colormap("jet")
                clim([0 30])
                c.Label.String = 'K_{ExB} [eV]';
            case 'KExBr+dTi'
                contourf(WAV_IDSPdata.time,buf_dTi(:,1),buf_dTi(:,2:end)+KExB_r,[-10:0.1:50],'LineStyle','none')
                c = colorbar;
                colormap("jet")
                clim([0 30])
                c.Label.String = 'K_{ExB,r}+\DeltaT_i [eV]';
            case 'KExBz'
                contourf(WAV_IDSPdata.time,buf_dTi(:,1),KExB_z,[-10:0.1:50],'LineStyle','none')
                c = colorbar;
                colormap("jet")
                % clim([-12 0])
                c.Label.String = 'K_{ExB,z} [eV]';
            case 'dTi'
                contourf(WAV_IDSPdata.time,buf_dTi(:,1),buf_dTi(:,2:end),[-10:0.1:50],'LineStyle','none')
                c = colorbar;
                colormap("jet")
                clim([0 40])
                c.Label.String = '\DeltaT_i [eV]';
            case 'dTi/dt'
                dTidt = diff(buf_dTi(:,2:end),1,2)./(WAV_IDSPdata.time(2)-WAV_IDSPdata.time(1));
                contourf(WAV_IDSPdata.time(1:end-1)+2,buf_dTi(:,1),dTidt,100,'LineStyle','none')
                c = colorbar;
                colormap("jet")
                c.Label.String = 'dT_i/dt [eV/us]';
            case 'Vz'
                contourf(WAV_IDSPdata.time,buf_Vz(:,1),buf_Vz(:,2:end),100,'LineStyle','none')
                c = colorbar;
                colormap("jet")
                % clim([-10 0])
                c.Label.String = 'V_z [km/s]';
            case 'Vr'
                contourf(WAV_IDSPdata.time,buf_Vr(:,1),buf_Vr(:,2:end),[-20:0.05:10],'LineStyle','none')
                c = colorbar;
                colormap("jet")
                clim([-12 0])
                c.Label.String = 'V_r [km/s]';
            case '|Vr|'
                contourf(WAV_IDSPdata.time,buf_Vr(:,1),abs(buf_Vr(:,2:end)),[-20:0.05:10],'LineStyle','none')
                c = colorbar;
                colormap("jet")
                clim([0 10])
                c.Label.String = '|V_r| [km/s]';
            case 'dVr/dr'
                dVrdt = -diff(buf_Vr(:,2:end),1,1)./(buf_Vr(2,1)-buf_Vr(1,1));
                dVrdt = movmean(dVrdt,5,1);
                contourf(WAV_IDSPdata.time,buf_Vr(2:end,1),dVrdt,[-400:1:400],'LineStyle','none')
                c = colorbar;
                colormap("redblue")
                clim([-200 200])
                c.Label.String = 'dV_r/dr [km/(s・m)]';
            case 'Kr'
                contourf(WAV_IDSPdata.time,buf_Vr(:,1),Kr,[-10:0.1:30],'LineStyle','none')
                c = colorbar;
                colormap("jet")
                clim([0 20])
                c.Label.String = 'K_r [eV]';
            case 'Krz'
                contourf(WAV_IDSPdata.time,buf_Vr(:,1),Krz,[-10:0.1:50],'LineStyle','none')
                c = colorbar;
                colormap("jet")
                % clim([0 20])
                c.Label.String = 'K_{rz} [eV]';
            case 'dTi+Krz'
                contourf(WAV_IDSPdata.time,buf_dTi(:,1),Krz_for_Ti+buf_dTi(:,2:end),[-10:0.1:50],'LineStyle','none')
                c = colorbar;
                colormap("jet")
                % clim([0 20])
                c.Label.String = '\DeltaT_i+K_{rz} [eV]';
        end
        hold on
        switch plot_ytype
            case 'VExBr'
            otherwise
                %計測点
                for i_r = 1: size(WAV_IDSPdata.r,1)
                    for i_t = 1: size(WAV_IDSPdata.time,1)
                        if (~isnan(WAV_IDSPdata.V_r(i_r,i_t))) && ismember(i_r,wav_range)
                            p = plot(WAV_IDSPdata.time(i_t,1),WAV_IDSPdata.r(i_r,1),"w+",'LineWidth',3);%測定位置
                            hold on
                        end
                    end
                end
        end
        plot(PCBdata2D.trange',PCBdata2D.x_pos(:,2),'mx--','LineWidth',3,'MarkerSize',10)
        xlim([462 482])
        ylim([0.11 0.27])
        xlabel('Time [us]')
        ylabel('r [m]')
end

switch plot_linetype
    case {'errbar','line'}
        xlim([0.07 0.27])
        xlabel('r [m]')
        legend(hs,legendStrings,'Location','eastoutside')
        switch plot_ytype
            case 'dTi'
                ylabel('\DeltaT_i [eV]')
            case 'Vz'
                yline(0,'k--','LineWidth',3);
                ylabel('V_z [km/s]')
            case 'Vr'
                yline(0,'k--','LineWidth',3);
                ylabel('V_r [km/s]')
        end
    case 'contour'
end

grid on
fontsize(20,"points")



